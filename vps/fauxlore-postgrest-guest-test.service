[Unit]
Description=Fauxlore isolated guest browser preview gateway
After=fauxlore-postgrest-bridge-test.service
Requires=fauxlore-postgrest-bridge-test.service

[Service]
User=fauxlore_rpc
Group=fauxlore_rpc
WorkingDirectory=/opt/fauxlore-auth
ExecStart=/opt/fauxlore-auth-venv/bin/python -m uvicorn postgrest_guest_preview:app --host 127.0.0.1 --port 18088 --no-access-log
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
