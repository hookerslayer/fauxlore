[Unit]
Description=Fauxlore production candidate RPC and projections (loopback only)
After=postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=fauxlore_rpc
Group=fauxlore_rpc
EnvironmentFile=/etc/fauxlore/production.env
WorkingDirectory=/opt/fauxlore-auth
ExecStart=/opt/fauxlore-auth-venv/bin/python -m uvicorn rpc_app:create_app --factory --host 127.0.0.1 --port 18183 --no-access-log
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
