[Unit]
Description=Fauxlore isolated authenticated read-only test API
After=postgresql.service

[Service]
Type=simple
User=fauxlore_rpc
Group=fauxlore_rpc
WorkingDirectory=/opt/fauxlore-auth
ExecStart=/opt/fauxlore-auth-venv/bin/python -m uvicorn rpc_app:create_app --factory --host 127.0.0.1 --port 18083 --no-access-log
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
